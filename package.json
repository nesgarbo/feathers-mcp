{
  "name": "feathers-mcp",
  "description": "MCP implementation for FeathersJS",
  "version": "3.0.0",
  "type": "module",
  "homepage": "https://github.com/nesgarbo/feathers-mcp",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "feathers",
    "feathers-plugin",
    "mcp",
    "modelcontextprotocol",
    "ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nesgarbo/feathers-mcp.git"
  },
  "author": {
    "name": "Nesgarbo",
    "email": "nesgarbo@icloud.com",
    "url": "https://github.com/nesgarbo"
  },
  "contributors": [
    {
      "name": "Vigalo",
      "url": "https://github.com/vigalo"
    }
  ],
  "bugs": {
    "url": "https://github.com/nesgarbo/feathers-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vitest watch",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@feathersjs/authentication": "^5.0.0",
    "@feathersjs/errors": "^5.0.0",
    "@feathersjs/express": "^5.0.0",
    "@feathersjs/feathers": "^5.0.0",
    "@feathersjs/koa": "^5.0.0",
    "@feathersjs/typebox": "^5.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@feathersjs/express": {
      "optional": true
    },
    "@feathersjs/koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@feathersjs/authentication": "^5.0.46",
    "@feathersjs/errors": "^5.0.46",
    "@feathersjs/express": "^5.0.46",
    "@feathersjs/feathers": "^5.0.46",
    "@feathersjs/koa": "^5.0.46",
    "@feathersjs/typebox": "^5.0.46",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
