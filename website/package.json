{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && bash -c 'set -a; source .env; set +a; rsync -avz --delete dist/ \"$DEPLOY_USER@$DEPLOY_HOST:$DEPLOY_PATH\"'"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "astro": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
